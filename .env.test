# Variáveis usadas apenas pelos testes de integração (jest.config.integration.ts).
# Arquivo versionado de propósito: não contém nenhum segredo real.
NODE_ENV=test

# JWT / cookies
APP_SECRET=integration_test_app_secret
REFRESH_TOKEN_SECRET=integration_test_refresh_secret
REFRESH_TOKEN_COOKIE_MAX_AGE=604800
REFRESH_TOKEN_COOKIE_NAME=refresh_token
ACCESS_TOKEN_COOKIE_NAME=access_token

# 32 bytes em hex — exigido pelo CryptoProvider (Buffer.from(key, 'hex'))
CRYPTO_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

APP_API_URL=http://localhost:3334
APP_WEB_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
API_PORT=3334

# Postgres do docker-compose.test.yml
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=docker
DB_NAME=nimbus_test

# Redis do docker-compose.test.yml (sem senha)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASS=

# Nunca falar com o storage S3 nem com SMTP durante os testes
STORAGE_DISK=local
MAIL_DRIVER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=test
MAIL_PASS=test
