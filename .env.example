# JWT secret
APP_SECRET=
#development | production
NODE_ENV=
APP_API_URL=http://localhost:3333
APP_WEB_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
CRYPTO_SECRET_KEY=

# API
API_PORT=3333

# Postgres
DB_PORT=
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASS=

# SMTP Email Configuration
# For development: uses Ethereal Email (https://ethereal.email)
# For production: uses Resend (https://resend.com)
# 
# Development: MAIL_USER and MAIL_PASS from https://ethereal.email/register
# Production: MAIL_USER and MAIL_PASS from Resend
MAIL_USER=resend
MAIL_PASS=
MAIL_HOST=smtp.resend.com
MAIL_PORT=465 

# Storage (local | s3)
STORAGE_DISK=local
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=nimbus

# Observability | Grafana | Prometheus
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=
