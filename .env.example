# Obrigatórias em qualquer ambiente: APP_SECRET, REFRESH_TOKEN_SECRET,
# CRYPTO_SECRET_KEY (64 caracteres hex), APP_API_URL e APP_WEB_URL.
# Em produção também: CORS_ORIGIN, DB_*, REDIS_HOST.
# O servidor não sobe se faltar alguma (veja src/config/validateEnv.ts).

# JWT secrets
APP_SECRET=
REFRESH_TOKEN_SECRET=
#development | production
NODE_ENV=
APP_API_URL=http://localhost:3333
APP_WEB_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
CRYPTO_SECRET_KEY=

# Cookies (opcionais; têm default)
# REFRESH_TOKEN_COOKIE_NAME=refresh_token
# REFRESH_TOKEN_COOKIE_MAX_AGE=604800
# ACCESS_TOKEN_COOKIE_NAME=access_token

# API
API_PORT=3333

# Postgres
DB_PORT=
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASS=

# Email
MAIL_DRIVER=resend
RESEND_API_KEY=
# Signing secret do webhook (painel Resend > Webhooks), aponta para POST /webhooks/resend
RESEND_WEBHOOK_SECRET=

# Só para MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=

# Storage (local | s3)
STORAGE_DISK=local
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=nimbus
# S3_REGION=us-east-1

# Observability | Grafana | Prometheus
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=
